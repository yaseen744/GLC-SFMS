PORT=5000
MONGO_URI=mongodb://root:root@ac-3blg0o6-shard-00-00.18vmwre.mongodb.net:27017,ac-3blg0o6-shard-00-01.18vmwre.mongodb.net:27017,ac-3blg0o6-shard-00-02.18vmwre.mongodb.net:27017/sms_db?ssl=true&replicaSet=atlas-bwnmik-shard-0&authSource=admin&appName=Cluster0
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Used only by `npm run seed:admin` to create/update the first admin account.
# Leave ADMIN_PASSWORD unset so the script generates a strong random one for you.
ADMIN_USERNAME=admin
ADMIN_EMAIL=put_the_real_admin_email_here@example.com
# ADMIN_PASSWORD=

# --- Email (used to send login OTP codes) ---
# Gmail: turn on 2-Step Verification, then create an "App Password" at
# myaccount.google.com -> Security -> App Passwords. Use that here, NOT your normal Gmail password.
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_FROM_NAME=Global Learning Center
OTP_EXPIRY_MINUTES=5
